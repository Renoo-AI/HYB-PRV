<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Web Exploitation Playground</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
</head>
<body>
    <div id="app">
        <%- include('partials/sidebar') %>
        <main id="main-content">
            <header>
                <h1>// Web Exploitation Playground</h1>
                <div class="progress-bar">
                    PWNED: <span id="flag-count">0</span> / 20
                </div>
            </header>
            <div class="content-body">
                <div style="background: rgba(0, 255, 102, 0.05); border: 1px solid var(--accent); padding: 30px; border-radius: 4px; margin-bottom: 40px; position: relative; overflow: hidden;">
                    <div style="position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: var(--accent);"></div>
                    <h2 style="margin-top: 0; color: var(--accent); display: flex; align-items: center; gap: 10px; text-transform: uppercase; font-family: var(--font-mono);">
                        <i class="fas fa-terminal"></i> [INITIATING MISSION BRIEFING]
                    </h2>
                    <p style="font-size: 1.1rem; line-height: 1.6; color: var(--text-secondary);">
                        Welcome to the <strong>Web Exploitation CTF</strong>. Here, you'll find 20 target machines designed to teach you the fundamentals of web security.
                        No external tools are required—everything can be solved using just your browser and DevTools.
                        Byte, your AI companion, will assist your infiltration.
                    </p>
                    <a href="/room/1" class="btn btn-primary mt-2">[ Deploy Target 1 ] <i class="fas fa-play" style="margin-left: 5px;"></i></a>
                </div>

                <div class="rooms-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
                    <%
                        // Group rooms by category
                        const categories = {};
                        for (let i = 1; i <= 20; i++) {
                            const room = gameData[i];
                            if (!categories[room.category]) categories[room.category] = [];
                            categories[room.category].push({ id: i, ...room });
                        }
                    %>

                    <% for (const cat in categories) { %>
                        <div style="grid-column: 1 / -1; margin-top: 20px; border-bottom: 1px dashed var(--border); padding-bottom: 10px;">
                            <h3 style="color: var(--accent); margin: 0; text-transform: uppercase;">>> MODULE: <%= cat %></h3>
                        </div>
                        <% categories[cat].forEach(room => { %>
                            <a href="/room/<%= room.id %>" class="room-card" style="display: block; background: #0d1117; border: 1px solid var(--border); border-left: 3px solid var(--border); border-radius: 4px; padding: 20px; text-decoration: none; transition: var(--transition-smooth);">
                                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 15px;">
                                    <span style="background: rgba(0, 255, 102, 0.1); color: var(--accent); padding: 4px 8px; border-radius: 2px; font-size: 0.75rem; font-weight: bold; border: 1px solid rgba(0, 255, 102, 0.3);">TARGET-<%= room.id %></span>
                                    <span id="badge-<%= room.id %>" class="status-badge" style="color: var(--danger); font-size: 0.8rem; font-weight: bold;"><i class="fas fa-lock"></i> SECURED</span>
                                </div>
                                <h4 style="color: #fff; margin: 0 0 10px 0; font-size: 1.1rem; text-transform: uppercase;"><%= room.title %></h4>
                                <p style="color: var(--text-secondary); font-size: 0.85rem; margin: 0; line-height: 1.4;"><%= room.theme %></p>
                            </a>
                        <% }); %>
                    <% } %>
                </div>

                <div class="stats-container" style="margin-top: 60px;">
                    <h3>[ SYSTEM EXPLOIT LOGS ]</h3>
                    <ul id="skills-learned">
                        <!-- Skills will be populated by JS based on solved levels -->
                    </ul>
                </div>
            </div>

            <style>
                .room-card:hover { transform: translateY(-3px); box-shadow: 0 10px 20px rgba(0,0,0,0.5); border-color: var(--accent) !important; border-left: 3px solid var(--accent) !important; background: #111926 !important; }
                .status-solved { color: var(--success) !important; }
                .status-solved::before { content: "[ "; }
                .status-solved::after { content: " ]"; }
            </style>

        </main>

        <%- include('partials/byte-chat') %>
    </div>

    <script src="/js/main.js"></script>
    <script>
        window.currentLevel = 0; // Home
    </script>
</body>
</html>
