<%- include('layout', { title: 'Level 14: Hidden Input Field', levelNumber: 14, body: `
    <div class="challenge-box">
        <h2>Hidden doesn't mean secure</h2>
        <form method="POST" action="/level/14/update">
            <input type="hidden" name="isAdmin" value="false">
            <button type="submit" class="btn btn-primary">Update Profile</button>
        </form>
        <% if (typeof error !== 'undefined' && error) { %>
            <p class="error-msg"><%= error %></p>
        <% } %>
        <p>There's a hidden field that determines if you're an admin. Can you change it to true?</p>
    </div>
` }) %>
