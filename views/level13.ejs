<%- include(typeof isolated !== 'undefined' && isolated ? 'minimal_layout' : 'layout', { title: 'Level 13: Client-Side Validation Bypass', levelNumber: 13, body: `
    <div class="challenge-box">
        <h2>Bypass JS validation</h2>
        <form method="POST" action="/level/13/register${typeof isolated !== 'undefined' && isolated ? '?isolated=true' : ''}" onsubmit="return validateForm()">
            <input type="text" name="username" id="username" placeholder="Username (min 5 chars)" required>
            <button type="submit" class="btn btn-primary">Register</button>
        </form>
        ${error ? '<p class="error-msg">' + error + '</p>' : ''}
        <script>
            function validateForm() {
                if (document.getElementById('username').value.length < 5) {
                    alert('Username must be at least 5 characters long!');
                    return false;
                }
                return true;
            }
        </script>
        <p>The form blocks short usernames. But what if you bypass the JS validation to send a shorter username?</p>
    </div>
` }) %>
